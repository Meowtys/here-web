---
---

<section id="showcase" class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-here-border">
  <div class="max-w-2xl mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-here-primary">
      Interactive App Showcase
    </div>
    <h2 class="mt-1 text-2xl sm:text-3xl font-extrabold text-here-text tracking-tight">
      See Here! in Action on Android
    </h2>
    <p class="mt-2 text-sm sm:text-base text-here-muted">
      Explore real screens from the Here! Android app — from live on-device face scanning and multi-session schedules to turnout velocity charts and biometric roster management.
    </p>
  </div>

  <!-- Showcase Tab Selector -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" role="tablist" aria-label="App Showcase Screens">
    <button
      id="tab-btn-scanner"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="screen-scanner"
      class="showcase-tab-btn active px-3.5 py-2 rounded-here border border-here-primary bg-here-primary text-here-onPrimary text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="scanner"
    >
      📷 Live Face Scanner
    </button>
    <button
      id="tab-btn-events"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="screen-events"
      class="showcase-tab-btn px-3.5 py-2 rounded-here border border-here-border bg-here-surface text-here-muted hover:text-here-text hover:bg-here-tint/50 text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="events"
    >
      📅 Event Sessions Hub
    </button>
    <button
      id="tab-btn-analytics"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="screen-analytics"
      class="showcase-tab-btn px-3.5 py-2 rounded-here border border-here-border bg-here-surface text-here-muted hover:text-here-text hover:bg-here-tint/50 text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="analytics"
    >
      📊 Turnout Velocity Charts
    </button>
    <button
      id="tab-btn-roster"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="screen-roster"
      class="showcase-tab-btn px-3.5 py-2 rounded-here border border-here-border bg-here-surface text-here-muted hover:text-here-text hover:bg-here-tint/50 text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="roster"
    >
      👤 Biometric Roster &amp; Samples
    </button>
  </div>

  <!-- Showcase Stage: Authentic Android Screenshots + Feature Breakdown -->
  <div class="mt-6 here-card p-5 sm:p-8 bg-here-surface">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Realistic Android Device Frame with Real App Captures -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-[270px] sm:w-[296px] rounded-[40px] p-2.5 bg-[#1B242A] border-[3px] border-[#2E3C46] shadow-xl relative">
          <!-- Camera Punch-Hole -->
          <div class="w-3 h-3 rounded-full bg-black/90 absolute top-5 left-1/2 -translate-x-1/2 z-10 pointer-events-none border border-white/10"></div>

          <!-- Android Screen Viewport (1080x2424 native ratio) -->
          <div class="rounded-[30px] overflow-hidden bg-here-bg aspect-[1080/2424] relative select-none border border-black/20">
            <!-- Screen 1: Live Biometric Scanner -->
            <div id="screen-scanner" class="showcase-screen w-full h-full">
              <img
                src="/assets/showcase/live-scanner.png"
                alt="Here! Android app Live Face Scanner screen showing Time-in/Time-out toggle, Session 1: Keynote pill, 7 cached templates ready, and face alignment viewfinder"
                width="1080"
                height="2424"
                loading="eager"
                class="w-full h-full object-cover block"
              />
            </div>

            <!-- Screen 2: Event Sessions Hub -->
            <div id="screen-events" class="showcase-screen hidden w-full h-full">
              <img
                src="/assets/showcase/events-hub.png"
                alt="Here! Android app Event Sessions Hub for General Assembly & Workshop showing 7 Timed in, 5 Timed out, 1 To check, session filter pills, and student attendance cards"
                width="1080"
                height="2424"
                loading="lazy"
                class="w-full h-full object-cover block"
              />
            </div>

            <!-- Screen 3: Turnout Velocity Charts -->
            <div id="screen-analytics" class="showcase-screen hidden w-full h-full">
              <img
                src="/assets/showcase/event-analytics.png"
                alt="Here! Android app Event Analytics screen showing 88% Turnout ring chart, 86% Face-Verified stat, 15m Check-In Velocity bar chart, and Session Comparison progress bars"
                width="1080"
                height="2424"
                loading="lazy"
                class="w-full h-full object-cover block"
              />
            </div>

            <!-- Screen 4: Biometric Roster & Profiles -->
            <div id="screen-roster" class="showcase-screen hidden w-full h-full">
              <img
                src="/assets/showcase/biometric-roster.png"
                alt="Here! Android app CS Student Society Attendees Roster showing 8 registered students with multi-sample biometric badges and No face data indicators"
                width="1080"
                height="2424"
                loading="lazy"
                class="w-full h-full object-cover block"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Description & Screen Specifications -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Info Panel: Scanner -->
        <div id="info-scanner" class="showcase-info space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-success">
              100% On-Device Biometrics
            </span>
            <span class="text-xs font-semibold text-here-muted">
              Synced &middot; 7 templates ready
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Live Door Scanner with On-the-Go Face Enrollment
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            Switch seamlessly between <strong>Time in</strong> and <strong>Time out</strong>, select the active session window, and scan attendees right at the door. MobileFaceNet generates 192-dimensional embeddings directly on your phone — zero cloud latency or internet required.
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Face-First Registration:</strong> Unrecognized visitors can register their name, Student ID, and face sample on the spot during their very first check-in.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Offline Template Caching:</strong> Pre-caches group face templates locally so scanning works in lecture halls or basements without Wi-Fi.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Instant Manual Fallback:</strong> Tap <em>Manual</em> at the top or bottom of the scanner to log a Student ID without camera capture.</span>
            </li>
          </ul>
        </div>

        <!-- Info Panel: Events -->
        <div id="info-events" class="showcase-info hidden space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-tint">
              Multi-Day &amp; Multi-Session
            </span>
            <span class="text-xs font-semibold text-here-muted">
              Real-Time Status Filters
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Multi-Session Event Hub &amp; Manual ID Verification
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            Manage multi-day assemblies and multi-session workshops from a single screen. Filter your live roster by <strong>All</strong>, <strong>Timed in</strong>, <strong>Missing</strong>, or <strong>To check</strong> (manual Typed ID entries awaiting admin verification).
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Session Switcher Strip:</strong> Toggle between <em>Overview (All)</em> and individual sessions (e.g., <em>Session 1: Keynote</em>, <em>Session 2: AI Workshop</em>).</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Audit-Ready Check-In Cards:</strong> See exact Time-In and Time-Out timestamps alongside <code>Typed ID</code> badges for unverified manual entries.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Automatic Event Lock-on-End:</strong> Events automatically lock when their scheduled end window passes to prevent retroactive tampering.</span>
            </li>
          </ul>
        </div>

        <!-- Info Panel: Analytics -->
        <div id="info-analytics" class="showcase-info hidden space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-warning">
              Real-Time Turnout Intelligence
            </span>
            <span class="text-xs font-semibold text-here-muted">
              10m / 15m / 30m Histograms
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Check-In Velocity Timelines &amp; Session Drop-Off Tracking
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            Inspect overall turnout percentage, face-verified ratio, and arrival surges at a glance. Switch between <strong>10m</strong>, <strong>15m</strong>, and <strong>30m</strong> velocity buckets to see exactly when lines peaked.
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Peak Scan Callout Pill:</strong> Automatically highlights the busiest check-in window (e.g., <em>Peak: 09:00 (8 scans)</em>).</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Multi-Session Comparison Bars:</strong> Track attendance retention across Keynote, AI Workshop, and Hackathon sessions.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>1-Tap Sanitized CSV Export:</strong> Export spreadsheet-ready attendance reports directly from the top-right download button.</span>
            </li>
          </ul>
        </div>

        <!-- Info Panel: Roster -->
        <div id="info-roster" class="showcase-info hidden space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-tint">
              Biometric Roster &amp; Profiles
            </span>
            <span class="text-xs font-semibold text-here-muted">
              Multi-Sample Face Vectors
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Group Roster &amp; Multi-Sample Biometric Profiles
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            Every student enrolled at the door or added by an organizer is stored in your group roster with clear sample counts (<code>4 samples</code>, <code>3 samples</code>, or <code>No face data</code> for ID-only members).
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Multi-Angle Sample Storage:</strong> Capture additional face samples per student over time for resilient recognition across lighting conditions.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Opt-Out Friendly:</strong> Students who prefer not to use facial recognition remain first-class roster members with <code>No face data</code> badges.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Instant Search &amp; Management:</strong> Search by name or Student ID to manage face samples, edit details, or purge biometric data.</span>
            </li>
          </ul>
        </div>

        <!-- Quick Screen Switcher Pills inside Right Column -->
        <div class="pt-4 border-t border-here-border flex flex-wrap items-center justify-between gap-2 text-xs text-here-muted">
          <span>Captured live from <strong>Here! {`v2.1.0-beta.6`}</strong> on Android</span>
          <span class="font-bold text-here-primary">Click any tab above to switch screens &uarr;</span>
        </div>

      </div>

    </div>
  </div>

  <script is:inline>
    (function initShowcaseTabs() {
      const tabButtons = document.querySelectorAll('.showcase-tab-btn');
      const screens = document.querySelectorAll('.showcase-screen');
      const infoPanels = document.querySelectorAll('.showcase-info');

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target');
          if (!target) return;

          // Update Tab Buttons
          tabButtons.forEach((b) => {
            const isCurrent = b === btn;
            b.setAttribute('aria-selected', String(isCurrent));
            if (isCurrent) {
              b.classList.add('border-here-primary', 'bg-here-primary', 'text-here-onPrimary');
              b.classList.remove('border-here-border', 'bg-here-surface', 'text-here-muted');
            } else {
              b.classList.remove('border-here-primary', 'bg-here-primary', 'text-here-onPrimary');
              b.classList.add('border-here-border', 'bg-here-surface', 'text-here-muted');
            }
          });

          // Update Screens in Device Mockup
          screens.forEach((screen) => {
            if (screen.id === 'screen-' + target) {
              screen.classList.remove('hidden');
            } else {
              screen.classList.add('hidden');
            }
          });

          // Update Right Info Panels
          infoPanels.forEach((panel) => {
            if (panel.id === 'info-' + target) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });
    })();
  </script>
</section>
