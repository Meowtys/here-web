---
---

<section id="showcase" class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-here-border">
  <div class="max-w-2xl mb-8">
    <div class="text-xs font-bold uppercase tracking-wider text-here-primary">
      Interactive App Showcase
    </div>
    <h2 class="mt-1 text-2xl sm:text-3xl font-extrabold text-here-text tracking-tight">
      See Here! in Action on Android
    </h2>
    <p class="mt-2 text-sm sm:text-base text-here-muted">
      From creating your group and scheduling a quick 1-session club meeting (or a multi-day event) to checking students in on the go and exporting turnout reports — explore the full workflow below.
    </p>
  </div>

  <!-- Showcase Tab Selector -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" role="tablist" aria-label="App Showcase Screens">
    <button
      id="tab-btn-group"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="screen-group"
      class="showcase-tab-btn active px-3.5 py-2 rounded-here border border-here-primary bg-here-primary text-here-onPrimary text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="group"
    >
      🏠 Groups &amp; Events
    </button>
    <button
      id="tab-btn-scanner"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="screen-scanner"
      class="showcase-tab-btn px-3.5 py-2 rounded-here border border-here-border bg-here-surface text-here-muted hover:text-here-text hover:bg-here-tint/50 text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="scanner"
    >
      📷 Scan Attendance
    </button>
    <button
      id="tab-btn-events"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="screen-events"
      class="showcase-tab-btn px-3.5 py-2 rounded-here border border-here-border bg-here-surface text-here-muted hover:text-here-text hover:bg-here-tint/50 text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="events"
    >
      📋 Attendance List
    </button>
    <button
      id="tab-btn-analytics"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="screen-analytics"
      class="showcase-tab-btn px-3.5 py-2 rounded-here border border-here-border bg-here-surface text-here-muted hover:text-here-text hover:bg-here-tint/50 text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="analytics"
    >
      📊 Turnout &amp; CSV Export
    </button>
    <button
      id="tab-btn-roster"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="screen-roster"
      class="showcase-tab-btn px-3.5 py-2 rounded-here border border-here-border bg-here-surface text-here-muted hover:text-here-text hover:bg-here-tint/50 text-xs sm:text-sm font-bold whitespace-nowrap transition-colors"
      data-target="roster"
    >
      👤 Group Roster
    </button>
  </div>

  <!-- Showcase Stage: Authentic Android Screenshots + Feature Breakdown -->
  <div class="mt-6 here-card p-5 sm:p-8 bg-here-surface">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Realistic Android Device Frame with Real App Captures -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-[270px] sm:w-[296px] rounded-[40px] p-2.5 bg-[#1B242A] border-[3px] border-[#2E3C46] shadow-xl relative">
          <!-- Camera Punch-Hole -->
          <div class="w-3 h-3 rounded-full bg-black/90 absolute top-5 left-1/2 -translate-x-1/2 z-10 pointer-events-none border border-white/10"></div>

          <!-- Android Screen Viewport (1080x2424 native ratio) -->
          <div class="rounded-[30px] overflow-hidden bg-here-bg aspect-[1080/2424] relative select-none border border-black/20">
            <!-- Screen 1: Group Workspace & Events (1-Session + Multi-Session) -->
            <div id="screen-group" class="showcase-screen w-full h-full">
              <img
                src="/assets/showcase/group-workspace.png"
                alt="Here! Android app Group Workspace screen for CS Student Society showing 5 Members, 8 Attendees, + Add button, and both a 1-session event (Freshmen Club Orientation, 9:00 AM - 12:00 PM) and a multi-session event (General Assembly & Workshop)"
                width="1080"
                height="2424"
                loading="eager"
                class="w-full h-full object-cover block"
              />
            </div>

            <!-- Screen 2: Scan Attendance -->
            <div id="screen-scanner" class="showcase-screen hidden w-full h-full">
              <img
                src="/assets/showcase/live-scanner.png"
                alt="Here! Android app Scan Attendance screen showing Time-in/Time-out toggle, Session 1: Keynote pill, 7 cached templates ready, and face alignment viewfinder"
                width="1080"
                height="2424"
                loading="lazy"
                class="w-full h-full object-cover block"
              />
            </div>

            <!-- Screen 3: Attendance List & Check-Ins -->
            <div id="screen-events" class="showcase-screen hidden w-full h-full">
              <img
                src="/assets/showcase/events-hub.png"
                alt="Here! Android app Attendance List screen showing 7 Timed in, 5 Timed out, 1 To check, session filter pills, search bar, and student attendance cards"
                width="1080"
                height="2424"
                loading="lazy"
                class="w-full h-full object-cover block"
              />
            </div>

            <!-- Screen 4: Turnout & CSV Export -->
            <div id="screen-analytics" class="showcase-screen hidden w-full h-full">
              <img
                src="/assets/showcase/event-analytics.png"
                alt="Here! Android app Event Analytics screen showing 88% Turnout ring chart, 86% Face-Verified stat, 15m Check-In Velocity bar chart, and Session Comparison progress bars"
                width="1080"
                height="2424"
                loading="lazy"
                class="w-full h-full object-cover block"
              />
            </div>

            <!-- Screen 5: Group Roster -->
            <div id="screen-roster" class="showcase-screen hidden w-full h-full">
              <img
                src="/assets/showcase/biometric-roster.png"
                alt="Here! Android app CS Student Society Attendees Roster showing 8 registered students with multi-sample biometric badges and No face data indicators"
                width="1080"
                height="2424"
                loading="lazy"
                class="w-full h-full object-cover block"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Description & Screen Specifications -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Info Panel: Group Workspace & Events -->
        <div id="info-group" class="showcase-info space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-tint">
              Organization Workspace
            </span>
            <span class="text-xs font-semibold text-here-muted">
              Single-Session &amp; Multi-Session Events
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Create Your Group &amp; Schedule Any Type of Event
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            Set up a shared workspace for your student organization in seconds. Whether you're hosting a quick <strong>single-session meeting</strong> (like <em>Freshmen Club Orientation · 9:00 AM – 12:00 PM</em>) or a <strong>multi-day conference</strong> with multiple sessions, everything lives in one clean hub.
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Invite Checkers with a 6-Character Code or QR:</strong> Tap the share icon to invite fellow officers and attendance checkers to your group.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Standard 1-Session or Multi-Session Schedules:</strong> Create a simple one-window event by default, or flip one toggle when you need multi-day / AM-PM sessions.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>At-a-Glance Group Dashboard:</strong> Manage your group's <strong>Members</strong>, <strong>Attendees</strong> roster, permissions, and audit logs right from the top header.</span>
            </li>
          </ul>
        </div>

        <!-- Info Panel: Scanner -->
        <div id="info-scanner" class="showcase-info hidden space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-success">
              100% On-Device Biometrics
            </span>
            <span class="text-xs font-semibold text-here-muted">
              Synced &middot; 7 templates ready
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Check Students' Attendance on the Go
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            Attendance checkers can open the camera, toggle between <strong>Time in</strong> and <strong>Time out</strong>, and check students in wherever the event is happening. MobileFaceNet matches faces directly on your phone — no internet connection required.
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Walk-In Registration on the Spot:</strong> If a student isn't in the roster yet, checkers can register their Student ID, name, and face right from the scan prompt and record their attendance immediately.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Works Offline Anywhere:</strong> Group face templates are cached on-device (<code>Synced · 7 templates ready</code>) so checkers can record attendance in auditoriums, fields, or rooms without Wi-Fi.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Switch to Manual Attendance Anytime:</strong> Tap <em>Switch to manual attendance</em> at the bottom to type a Student ID when a student prefers not to use facial recognition.</span>
            </li>
          </ul>
        </div>

        <!-- Info Panel: Events / Attendance List -->
        <div id="info-events" class="showcase-info hidden space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-tint">
              Live Attendance Feed
            </span>
            <span class="text-xs font-semibold text-here-muted">
              Time-In / Time-Out &amp; Status Filters
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Track Time-In, Time-Out, Missing &amp; Manual Entries
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            Whether your event has a <strong>single attendance window</strong> or <strong>multiple sessions</strong>, you get real-time counts for <strong>Timed in</strong>, <strong>Timed out</strong>, and <strong>To check</strong>. Search by name or Student ID and filter by status in one tap.
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>See Who's Here &amp; Who's Missing:</strong> Filter between <em>All</em>, <em>Timed in</em>, <em>Missing</em> (registered members who haven't arrived yet), and <em>To check</em>.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Verify Manual ID Check-Ins:</strong> Manual ID entries are marked with a <code>Typed ID</code> badge so admins can verify them individually or in 1 tap under <em>To check</em>.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Optional Session Pills &amp; Auto-Lock:</strong> Multi-session events add a session switcher bar at the top, and any event can auto-lock when its end time passes.</span>
            </li>
          </ul>
        </div>

        <!-- Info Panel: Analytics -->
        <div id="info-analytics" class="showcase-info hidden space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-warning">
              Turnout &amp; Reports
            </span>
            <span class="text-xs font-semibold text-here-muted">
              10m / 15m / 30m Histograms
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Turnout Summary, Check-In Velocity &amp; CSV Export
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            See your event's turnout percentage, present vs. absent counts, full (in &amp; out) completion, and face-verified rate. Toggle between <strong>10m</strong>, <strong>15m</strong>, and <strong>30m</strong> intervals to see when check-ins peaked.
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Peak Scan Window Callout:</strong> Automatically pinpoints the busiest arrival rush (e.g., <em>Peak: 09:00 (8 scans)</em>).</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Works for Single or Multi-Session Events:</strong> View overall turnout for single-window events, plus session-by-session comparison bars for multi-session events.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>1-Tap CSV Export:</strong> Download or share spreadsheet-ready CSV attendance sheets directly from the top-right export button.</span>
            </li>
          </ul>
        </div>

        <!-- Info Panel: Roster -->
        <div id="info-roster" class="showcase-info hidden space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-tint">
              Attendees &amp; Face Samples
            </span>
            <span class="text-xs font-semibold text-here-muted">
              Multi-Angle Recognition
            </span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-here-text tracking-tight">
            Roster Built Automatically as You Check Students In
          </h3>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed">
            Every student registered on the go during check-in (or added in advance) appears in your group's <strong>Attendees</strong> list with their enrolled sample count (<code>4 samples</code>, <code>3 samples</code>, or <code>No face data</code>).
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Link Faces or Add Angles Anytime:</strong> Checkers can link a new face scan to an existing roster member or add extra angles to improve matching accuracy.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Works With or Without Face Consent:</strong> Students who decline face storage are still saved to the roster with <code>No face data</code> for quick manual check-ins.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><strong>Full Attendance History &amp; Privacy Control:</strong> Tap any student to view their attendance history across events or reset their face samples at any time.</span>
            </li>
          </ul>
        </div>

        <!-- Quick Screen Switcher Pills inside Right Column -->
        <div class="pt-4 border-t border-here-border flex flex-wrap items-center justify-between gap-2 text-xs text-here-muted">
          <span>Captured live from <strong>Here! {`v2.1.0-beta.6`}</strong> on Android</span>
          <span class="font-bold text-here-primary">Click any tab above to switch screens &uarr;</span>
        </div>

      </div>

    </div>
  </div>

  <script is:inline>
    (function initShowcaseTabs() {
      const tabButtons = document.querySelectorAll('.showcase-tab-btn');
      const screens = document.querySelectorAll('.showcase-screen');
      const infoPanels = document.querySelectorAll('.showcase-info');

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target');
          if (!target) return;

          // Update Tab Buttons
          tabButtons.forEach((b) => {
            const isCurrent = b === btn;
            b.setAttribute('aria-selected', String(isCurrent));
            if (isCurrent) {
              b.classList.add('border-here-primary', 'bg-here-primary', 'text-here-onPrimary');
              b.classList.remove('border-here-border', 'bg-here-surface', 'text-here-muted');
            } else {
              b.classList.remove('border-here-primary', 'bg-here-primary', 'text-here-onPrimary');
              b.classList.add('border-here-border', 'bg-here-surface', 'text-here-muted');
            }
          });

          // Update Screens in Device Mockup
          screens.forEach((screen) => {
            if (screen.id === 'screen-' + target) {
              screen.classList.remove('hidden');
            } else {
              screen.classList.add('hidden');
            }
          });

          // Update Right Info Panels
          infoPanels.forEach((panel) => {
            if (panel.id === 'info-' + target) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });
    })();
  </script>
</section>
