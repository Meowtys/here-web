  <script is:inline>
    (function initShowcaseTabs() {
      const tabButtons = document.querySelectorAll('.showcase-tab-btn');
      const screens = document.querySelectorAll('.showcase-screen');
      const infoPanels = document.querySelectorAll('.showcase-info');

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target');
          if (!target) return;

          // Update Tab Buttons
          tabButtons.forEach((b) => {
            const isCurrent = b === btn;
            b.setAttribute('aria-selected', String(isCurrent));
            if (isCurrent) {
              b.classList.add('border-here-primary', 'bg-here-primary', 'text-here-onPrimary');
              b.classList.remove('border-here-border', 'bg-here-surface', 'text-here-muted');
            } else {
              b.classList.remove('border-here-primary', 'bg-here-primary', 'text-here-onPrimary');
              b.classList.add('border-here-border', 'bg-here-surface', 'text-here-muted');
            }
          });

          // Update Screens in Device Mockup
          screens.forEach((screen) => {
            if (screen.id === 'screen-' + target) {
              screen.classList.remove('hidden');
            } else {
              screen.classList.add('hidden');
            }
          });

          // Update Right Info Panels
          infoPanels.forEach((panel) => {
            if (panel.id === 'info-' + target) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });
    })();
  </script>
</section>
