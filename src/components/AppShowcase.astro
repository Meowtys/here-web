---

<section id="showcase" class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-here-border">
  <div class="max-w-3xl mb-8">
    <div class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider text-here-primary bg-here-tint px-2.5 py-1 rounded-full mb-2">
      <span>Interactive Multi-Screen Showcase</span>
    </div>
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-here-text tracking-tight">
      Explore Real Android Screens from Here!
    </h2>
    <p class="mt-2 text-sm sm:text-base text-here-muted leading-relaxed">
      Each section below features authentic captures from our Android app on emulator. Click any category tab, then switch between the screenshot gallery slides using the sub-tabs or arrows below.
    </p>
  </div>

  <!-- Main Category Tabs -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar" role="tablist" aria-label="Showcase Categories">
    {categories.map((cat, idx) => (
      <button
        id={`cat-btn-${cat.id}`}
        type="button"
        role="tab"
        aria-selected={idx === 0 ? 'true' : 'false'}
        aria-controls={`gallery-panel-${cat.id}`}
        class:list={[
          'showcase-cat-btn px-4 py-2.5 rounded-here text-xs sm:text-sm font-bold whitespace-nowrap transition-all flex items-center gap-2 shadow-xs shrink-0',
          idx === 0
            ? 'active bg-here-primary text-here-onPrimary border border-here-primary'
            : 'bg-here-surface text-here-muted border border-here-border hover:text-here-text hover:bg-here-tint/50',
        ]}
        data-cat={cat.id}
      >
        <span>{cat.icon}</span>
        <span>{cat.tabLabel}</span>
      </button>
    ))}
  </div>

  <!-- Showcase Stage -->
  <div class="mt-6 here-card p-4 sm:p-6 lg:p-8 bg-here-surface border border-here-border shadow-md">
    
    <!-- Sub-Slide Gallery Switcher Bar -->
    <div class="mb-6 pb-4 border-b border-here-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="text-[11px] font-extrabold uppercase tracking-wider text-here-muted">Gallery Screens</div>
        <div id="gallery-title" class="text-base sm:text-lg font-extrabold text-here-text">
          Organization Workspace
        </div>
      </div>

      <!-- Slide Selector Pills Container -->
      <div id="sub-tabs-container" class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 no-scrollbar" role="tablist" aria-label="Gallery Slides">
        <!-- Injected via JavaScript based on active category -->
      </div>
    </div>

    <!-- Main Grid: Phone Mockup + Dynamic Info Column -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Realistic Android Device Frame with Multi-Slide Screenshots -->
      <div class="lg:col-span-5 flex flex-col items-center">
        
        <!-- Phone Frame Container -->
        <div class="w-[270px] sm:w-[296px] rounded-[42px] p-2.5 bg-[#182127] border-[3px] border-[#2A3742] shadow-2xl relative">
          <!-- Camera Punch-Hole -->
          <div class="w-3.5 h-3.5 rounded-full bg-black/95 absolute top-5 left-1/2 -translate-x-1/2 z-20 pointer-events-none border border-white/10 shadow-inner"></div>

          <!-- Carousel Arrow Buttons -->
          <button
            id="prev-slide-btn"
            type="button"
            aria-label="Previous screenshot in gallery"
            class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-black/65 hover:bg-black/85 text-white flex items-center justify-center backdrop-blur-xs border border-white/20 transition-all hover:scale-105 active:scale-95 shadow-md cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button
            id="next-slide-btn"
            type="button"
            aria-label="Next screenshot in gallery"
            class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-black/65 hover:bg-black/85 text-white flex items-center justify-center backdrop-blur-xs border border-white/20 transition-all hover:scale-105 active:scale-95 shadow-md cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>

          <!-- Android Screen Viewport (1080x2424 native aspect) -->
          <div class="rounded-[32px] overflow-hidden bg-here-bg aspect-[1080/2424] relative select-none border border-black/30 shadow-inner">
            {categories.map((cat) =>
              cat.slides.map((slide, sIdx) => (
                <div
                  id={`screen-img-${slide.id}`}
                  class:list={[
                    'showcase-img-slide w-full h-full absolute inset-0 transition-opacity duration-200',
                    cat.id === 'group' && sIdx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none',
                  ]}
                  data-cat={cat.id}
                  data-slide-id={slide.id}
                >
                  <img
                    src={slide.image}
                    alt={slide.alt}
                    width="1080"
                    height="2424"
                    loading="eager" decoding="async"
                    class="w-full h-full object-cover block"
                  />
                </div>
              ))
            )}
          </div>
        </div>

        <!-- Slide Indicator Dots and Counter -->
        <div class="mt-4 flex items-center gap-3 text-xs font-bold text-here-muted">
          <div id="slide-dots-container" class="flex items-center gap-1.5">
            <!-- Dynamic dots injected by JS -->
          </div>
          <span id="slide-counter-text" class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded-full bg-here-tint text-here-primary">
            Slide 1 of 3
          </span>
        </div>

      </div>

      <!-- Right Column: Interactive Description & Screen Specifications -->
      <div class="lg:col-span-7 space-y-5">
        
        {categories.map((cat) =>
          cat.slides.map((slide, sIdx) => (
            <div
              id={`slide-info-${slide.id}`}
              class:list={[
                'showcase-slide-info space-y-4',
                cat.id === 'group' && sIdx === 0 ? 'block' : 'hidden',
              ]}
              data-cat={cat.id}
              data-slide-id={slide.id}
            >
              <div class="inline-flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-tint">
                  {slide.categoryBadge}
                </span>
                <span class="text-xs font-semibold text-here-muted">
                  {slide.subtitle}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl lg:text-[26px] font-extrabold text-here-text tracking-tight leading-snug">
                {slide.title}
              </h3>

              <p class="text-sm sm:text-base text-here-muted leading-relaxed">
                {slide.description}
              </p>

              <div class="pt-2">
                <div class="text-xs font-bold uppercase tracking-wider text-here-muted mb-2">Screen Highlights</div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-here-text font-semibold">
                  {slide.highlights.map((h) => (
                    <li class="flex items-start gap-2.5">
                      <div class="w-5 h-5 rounded-full bg-here-tint text-here-primary flex items-center justify-center shrink-0 mt-0.5">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                      </div>
                      <span><strong class="text-here-primary">{h.title}</strong> {h.desc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        )}

        <!-- Quick Switcher Helper Card -->
        <div class="pt-4 border-t border-here-border flex flex-wrap items-center justify-between gap-2 text-xs text-here-muted">
          <span>Captured live from <strong>Here! v2.1.0-beta.6</strong> (Android Emulator)</span>
          <span class="font-bold text-here-primary inline-flex items-center gap-1">
            <span>Use &larr; &rarr; arrows or sub-tabs to browse</span>
          </span>
        </div>

      </div>

    </div>
  </div>

  <script is:inline define:vars={{ categoriesData: categories }}>
    (function initShowcaseGalleries() {
      const categories = categoriesData;
      let activeCatId = 'group';
      let activeSlideIndex = 0;

      const catButtons = document.querySelectorAll('.showcase-cat-btn');
      const subTabsContainer = document.getElementById('sub-tabs-container');
      const galleryTitle = document.getElementById('gallery-title');
      const prevBtn = document.getElementById('prev-slide-btn');
      const nextBtn = document.getElementById('next-slide-btn');
      const dotsContainer = document.getElementById('slide-dots-container');
      const counterText = document.getElementById('slide-counter-text');

      function getCurrentCategory() {
        return categories.find((c) => c.id === activeCatId) || categories[0];
      }

      function renderSubTabs() {
        if (!subTabsContainer) return;
        const currentCat = getCurrentCategory();
        subTabsContainer.innerHTML = '';

        currentCat.slides.forEach((slide, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.role = 'tab';
          btn.className = [
            'px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all border shrink-0 cursor-pointer',
            idx === activeSlideIndex
              ? 'bg-here-primary text-here-onPrimary border-here-primary shadow-xs'
              : 'bg-here-surface text-here-muted border-here-border hover:bg-here-tint/50 hover:text-here-text',
          ].join(' ');
          btn.textContent = slide.label;
          btn.setAttribute('aria-selected', String(idx === activeSlideIndex));
          btn.addEventListener('click', () => {
            setSlideIndex(idx);
          });
          subTabsContainer.appendChild(btn);
        });

        renderDots();
      }

      function renderDots() {
        if (!dotsContainer) return;
        const currentCat = getCurrentCategory();
        dotsContainer.innerHTML = '';

        currentCat.slides.forEach((_, idx) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.setAttribute('aria-label', 'Go to slide ' + (idx + 1));
          dot.className = [
            'w-2 h-2 rounded-full transition-all cursor-pointer',
            idx === activeSlideIndex ? 'bg-here-primary w-5' : 'bg-here-border hover:bg-here-muted',
          ].join(' ');
          dot.addEventListener('click', () => {
            setSlideIndex(idx);
          });
          dotsContainer.appendChild(dot);
        });

        if (counterText) {
          counterText.textContent = 'Slide ' + (activeSlideIndex + 1) + ' of ' + currentCat.slides.length;
        }

        if (galleryTitle) {
          const slide = currentCat.slides[activeSlideIndex];
          if (slide) galleryTitle.textContent = slide.title;
        }
      }

      function updateVisuals() {
        const currentCat = getCurrentCategory();
        const activeSlide = currentCat.slides[activeSlideIndex];
        if (!activeSlide) return;

        // Update Phone Images
        const allImgSlides = document.querySelectorAll('.showcase-img-slide');
        allImgSlides.forEach((el) => {
          if (el.getAttribute('data-slide-id') === activeSlide.id) {
            el.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
            el.classList.add('opacity-100', 'z-10');
          } else {
            el.classList.add('opacity-0', 'pointer-events-none', 'z-0');
            el.classList.remove('opacity-100', 'z-10');
          }
        });

        // Update Right Info Cards
        const allInfoCards = document.querySelectorAll('.showcase-slide-info');
        allInfoCards.forEach((el) => {
          if (el.getAttribute('data-slide-id') === activeSlide.id) {
            el.classList.remove('hidden');
            el.classList.add('block');
          } else {
            el.classList.add('hidden');
            el.classList.remove('block');
          }
        });

        // Update Sub-Tab Buttons styling
        if (subTabsContainer) {
          Array.from(subTabsContainer.children).forEach((child, idx) => {
            const isCurrent = idx === activeSlideIndex;
            child.setAttribute('aria-selected', String(isCurrent));
            if (isCurrent) {
              child.className =
                'px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all border shrink-0 bg-here-primary text-here-onPrimary border-here-primary shadow-xs cursor-pointer';
            } else {
              child.className =
                'px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all border shrink-0 bg-here-surface text-here-muted border-here-border hover:bg-here-tint/50 hover:text-here-text cursor-pointer';
            }
          });
        }

        renderDots();
      }

      function setSlideIndex(index) {
        const currentCat = getCurrentCategory();
        const total = currentCat.slides.length;
        activeSlideIndex = (index + total) % total;
        updateVisuals();
      }

      function setCategory(catId) {
        activeCatId = catId;
        activeSlideIndex = 0;

        // Update Category Buttons
        catButtons.forEach((btn) => {
          const isSelected = btn.getAttribute('data-cat') === catId;
          btn.setAttribute('aria-selected', String(isSelected));
          if (isSelected) {
            btn.className =
              'showcase-cat-btn px-4 py-2.5 rounded-here text-xs sm:text-sm font-bold whitespace-nowrap transition-all flex items-center gap-2 shadow-xs shrink-0 active bg-here-primary text-here-onPrimary border border-here-primary cursor-pointer';
          } else {
            btn.className =
              'showcase-cat-btn px-4 py-2.5 rounded-here text-xs sm:text-sm font-bold whitespace-nowrap transition-all flex items-center gap-2 shadow-xs shrink-0 bg-here-surface text-here-muted border border-here-border hover:text-here-text hover:bg-here-tint/50 cursor-pointer';
          }
        });

        renderSubTabs();
        updateVisuals();
      }

      // Event Listeners for Category Buttons
      catButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat');
          if (cat) setCategory(cat);
        });
      });

      // Carousel Controls
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          setSlideIndex(activeSlideIndex - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          setSlideIndex(activeSlideIndex + 1);
        });
      }

      // Initial Mount
      renderSubTabs();
      updateVisuals();
    })();
  </script>
</section>
