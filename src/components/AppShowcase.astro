---
interface Slide {
  id: string;
  label: string;
  image: string;
  alt: string;
  categoryBadge: string;
  subtitle: string;
  title: string;
  description: string;
  highlights: { title: string; desc: string }[];
}

interface Category {
  id: string;
  tabLabel: string;
  slides: Slide[];
}

