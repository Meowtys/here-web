---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header id="site-header" class="sticky top-0 z-40 bg-here-bg/95 backdrop-blur-sm border-b border-here-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-here-text font-extrabold text-xl tracking-tight rounded-lg py-1.5 px-2 -ml-2 hover:bg-here-tint/60 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors shrink-0"
      aria-label="Here! Home"
    >
      <img
        src="/assets/logo.png"
        alt="Here! Arrow Logo"
        width="24"
        height="24"
        class="w-6 h-6 object-contain shrink-0"
      />
      <span class="font-extrabold text-xl tracking-tight text-here-text">Here!</span>
      <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-here-tint text-here-primary border border-here-primary/20">
        beta
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Primary Navigation" class="hidden md:flex items-center gap-1">
      <a
        href="/#showcase"
        class="px-3 py-2 rounded-lg text-sm font-semibold text-here-muted hover:text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors"
      >
        Showcase
      </a>
      <a
        href="/#features"
        class="px-3 py-2 rounded-lg text-sm font-semibold text-here-muted hover:text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors"
      >
        Features
      </a>
      <a
        href="/#how-it-works"
        class="px-3 py-2 rounded-lg text-sm font-semibold text-here-muted hover:text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors"
      >
        How It Works
      </a>
      <a
        href="/#install"
        class="px-3 py-2 rounded-lg text-sm font-semibold text-here-muted hover:text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors"
      >
        Install Guide
      </a>
      <a
        href="/changelog"
        aria-current={currentPath.startsWith('/changelog') ? 'page' : undefined}
        class:list={[
          'px-3 py-2 rounded-lg text-sm font-semibold focus-visible:ring-2 focus-visible:ring-here-primary transition-colors',
          currentPath.startsWith('/changelog')
            ? 'bg-here-tint text-here-primary font-bold'
            : 'text-here-muted hover:text-here-text hover:bg-here-tint/50',
        ]}
      >
        Changelog
      </a>
      <a
        href="/privacy"
        aria-current={currentPath.startsWith('/privacy') ? 'page' : undefined}
        class:list={[
          'px-3 py-2 rounded-lg text-sm font-semibold focus-visible:ring-2 focus-visible:ring-here-primary transition-colors',
          currentPath.startsWith('/privacy')
            ? 'bg-here-tint text-here-primary font-bold'
            : 'text-here-muted hover:text-here-text hover:bg-here-tint/50',
        ]}
      >
        Privacy
      </a>
      <a
        href="/terms"
        aria-current={currentPath.startsWith('/terms') ? 'page' : undefined}
        class:list={[
          'px-3 py-2 rounded-lg text-sm font-semibold focus-visible:ring-2 focus-visible:ring-here-primary transition-colors',
          currentPath.startsWith('/terms')
            ? 'bg-here-tint text-here-primary font-bold'
            : 'text-here-muted hover:text-here-text hover:bg-here-tint/50',
        ]}
      >
        Terms
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/#download"
        class="inline-flex items-center justify-center min-h-[44px] md:min-h-[40px] px-4 py-2 rounded-here bg-here-primary text-here-onPrimary text-xs sm:text-sm font-bold hover:bg-[#184B66] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-here-primary transition-colors shrink-0"
      >
        <span>Get APK</span>
      </a>

      <!-- Mobile Menu Toggle Button (44x44px touch target) -->
      <button
        id="mobile-nav-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 min-w-[44px] min-h-[44px] rounded-here border border-here-border bg-here-surface text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors shrink-0 cursor-pointer"
        aria-controls="mobile-nav-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <svg id="icon-menu-open" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-menu-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-nav-menu" class="hidden md:hidden border-t border-here-border bg-here-surface px-4 py-3 space-y-1">
    <a
      href="/#showcase"
      class="flex items-center min-h-[44px] px-3 rounded-lg text-sm font-semibold text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors"
    >
      Showcase
    </a>
    <a
      href="/#features"
      class="flex items-center min-h-[44px] px-3 rounded-lg text-sm font-semibold text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors"
    >
      Features
    </a>
    <a
      href="/#how-it-works"
      class="flex items-center min-h-[44px] px-3 rounded-lg text-sm font-semibold text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors"
    >
      How It Works
    </a>
    <a
      href="/#install"
      class="flex items-center min-h-[44px] px-3 rounded-lg text-sm font-semibold text-here-text hover:bg-here-tint/50 focus-visible:ring-2 focus-visible:ring-here-primary transition-colors"
    >
      Install Guide
    </a>
    <a
      href="/changelog"
      aria-current={currentPath.startsWith('/changelog') ? 'page' : undefined}
      class:list={[
        'flex items-center min-h-[44px] px-3 rounded-lg text-sm font-semibold focus-visible:ring-2 focus-visible:ring-here-primary transition-colors',
        currentPath.startsWith('/changelog') ? 'bg-here-tint text-here-primary font-bold' : 'text-here-text hover:bg-here-tint/50',
      ]}
    >
      Changelog
    </a>
    <a
      href="/privacy"
      aria-current={currentPath.startsWith('/privacy') ? 'page' : undefined}
      class:list={[
        'flex items-center min-h-[44px] px-3 rounded-lg text-sm font-semibold focus-visible:ring-2 focus-visible:ring-here-primary transition-colors',
        currentPath.startsWith('/privacy') ? 'bg-here-tint text-here-primary font-bold' : 'text-here-text hover:bg-here-tint/50',
      ]}
    >
      Privacy Policy
    </a>
    <a
      href="/terms"
      aria-current={currentPath.startsWith('/terms') ? 'page' : undefined}
      class:list={[
        'flex items-center min-h-[44px] px-3 rounded-lg text-sm font-semibold focus-visible:ring-2 focus-visible:ring-here-primary transition-colors',
        currentPath.startsWith('/terms') ? 'bg-here-tint text-here-primary font-bold' : 'text-here-text hover:bg-here-tint/50',
      ]}
    >
      Terms of Use
    </a>
  </div>

  <script is:inline>
    const headerEl = document.getElementById('site-header');
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const menu = document.getElementById('mobile-nav-menu');
    const openIcon = document.getElementById('icon-menu-open');
    const closeIcon = document.getElementById('icon-menu-close');

    if (toggleBtn && menu) {
      function setMenuOpen(open, restoreFocus) {
        menu.classList.toggle('hidden', !open);
        toggleBtn.setAttribute('aria-expanded', String(open));
        if (openIcon && closeIcon) {
          openIcon.classList.toggle('hidden', open);
          closeIcon.classList.toggle('hidden', !open);
        }
        if (!open && restoreFocus) {
          toggleBtn.focus();
        }
      }

      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isExpanded, false);
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          setMenuOpen(false, false);
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          setMenuOpen(false, true);
        }
      });

      document.addEventListener('click', (e) => {
        if (
          !menu.classList.contains('hidden') &&
          headerEl &&
          e.target instanceof Node &&
          !headerEl.contains(e.target)
        ) {
          setMenuOpen(false, false);
        }
      });
    }
  </script>
</header>
