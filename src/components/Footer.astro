---
import { FALLBACK_RELEASE } from '../data/release';
---

<footer class="mt-auto border-t border-here-border bg-here-surface">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <img
          src="/assets/logo.png"
          alt="Here! Logo"
          width="36"
          height="36"
          class="w-9 h-9 rounded-here border border-here-border bg-here-surface p-1.5 object-contain"
        />
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold text-lg text-here-text tracking-tight">Here!</span>
            <span id="footer-release-version" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-here-tint text-here-primary">
              {FALLBACK_RELEASE.version}
            </span>
          </div>
          <p class="text-xs text-here-muted">
            Student Organization Attendance System &middot; Package <code class="font-mono text-here-text">{FALLBACK_RELEASE.packageName}</code>
          </p>
        </div>
      </div>

      <nav aria-label="Footer Navigation" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-semibold text-here-muted">
        <a href="/" class="hover:text-here-primary transition-colors">Showcase</a>
        <a href="/#features" class="hover:text-here-primary transition-colors">Features</a>
        <a href="/#how-it-works" class="hover:text-here-primary transition-colors">Quick Start</a>
        <a href="/changelog" class="hover:text-here-primary transition-colors">Changelog</a>
        <a href="/privacy" class="hover:text-here-primary transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-here-primary transition-colors">Terms of Use</a>
      </nav>
    </div>

    <div class="mt-8 pt-6 border-t border-here-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-here-muted">
      <p>&copy; {new Date().getFullYear()} Here! Project. Built for student organizations, clubs, and academic events.</p>
      <p>Android 7.0+ (API 24+) &middot; On-Device MobileFaceNet Biometrics</p>
    </div>
  </div>
</footer>
