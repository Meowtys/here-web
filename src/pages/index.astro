---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShowcase from '../components/AppShowcase.astro';
import { fetchLatestRelease, FALLBACK_RELEASE, RELEASES_API_URL } from '../data/release';

const release = await fetchLatestRelease();

const features = [
  {
    title: 'Face-First Check-In & On-the-Go Registration',
    badge: 'Synced - Offline ready',
    badgeStyle: 'here-pill-success',
    description:
      'Attendance checkers can check students in on the go without preparing a roster ahead of time. Scan faces to time in returning members instantly, or register new walk-in students right during their first scan — completely offline.',
    highlights: [
      'No pre-built roster needed — register new students & faces on the go',
      'Instant time-in & time-out camera recognition on future scans',
      'Local biometric caching (Synced - Offline ready) with automatic background sync',
    ],
  },
  {
    title: 'Single-Session & Multi-Session Events',
    badge: '1-Session or Multi-Day',
    badgeStyle: 'here-pill-success',
    description:
      'Schedule a quick 1-session club meeting or class in seconds, or flip a single toggle when you need multi-day conferences and AM/PM session schedules — complete with automatic lock-on-end and 1-tap verification for manual ID check-ins.',
    highlights: [
      'Fast 1-session event setup (Date, Start & End time) or multi-session schedules',
      'Live Timed in, Timed out, Missing & To check status filters',
      'Automatic event lock-on-end & 1-tap batch verification for Typed IDs',
    ],
  },
  {
    title: 'Turnout Analytics & CSV Exports',
    badge: '10m / 15m / 30m',
    badgeStyle: 'here-pill-tint',
    description:
      'Visualize check-in momentum with configurable velocity timelines (10m, 15m, or 30m intervals), peak scan tracking, cross-event member leaderboards, and spreadsheet-safe CSV exports.',
    highlights: [
      'Configurable check-in velocity timelines (10m / 15m / 30m)',
      'Peak scan window tracking & session retention comparison',
      'Cross-event leaderboards & formula-sanitized CSV exports',
    ],
  },
  {
    title: 'Role-Based Governance & Audit Logs',
    badge: 'Owner / Admin',
    badgeStyle: 'here-pill-warning',
    description:
      'Granular Owner, Admin, and Member permission controls backed by strict Cloud Firestore security rules and date-filtered governance audit logs for complete organizational accountability.',
    highlights: [
      'Owner, Admin & Member role-based access controls',
      '6-character group invite codes & join approval workflows',
      'Date-filtered governance audit logs for every action',
    ],
  },
];

const quickStartSteps = [
  {
    step: '01',
    title: '1. Create or Join a Group',
    subtitle: 'Organization Workspace',
    description:
      'Tap the + button on the Groups screen to create a student organization workspace, or join an existing group using a 6-character invite code or QR.',
  },
  {
    step: '02',
    title: '2. Create a 1-Session or Multi-Day Event',
    subtitle: 'No Roster Prep Needed',
    description:
      'Schedule a standard 1-session meeting or a multi-session event in seconds. Checkers can start taking attendance right away without importing a spreadsheet first.',
  },
  {
    step: '03',
    title: '3. Scan & Register on the Go',
    subtitle: 'Face-First Check-In',
    description:
      'Open the camera to check students in on the go. First-time walk-ins register their face and Student ID on the spot; returning members match in one tap — even offline.',
  },
  {
    step: '04',
    title: '4. Verify & Export Analytics',
    subtitle: 'Turnout & Governance',
    description:
      'Batch-verify manual ID entries in 1 tap, inspect 10m/15m/30m check-in velocity charts, review audit logs, and export sanitized CSV reports.',
  },
];

const installSteps = [
  {
    num: '1',
    title: 'Download the APK Package',
    body: 'Tap the "Download for Android (.apk)" button above to download the latest signed release directly to your device.',
  },
  {
    num: '2',
    title: 'Allow Installation from Your Browser',
    body: 'Open the downloaded .apk file. If prompted by Android, enable "Allow from this source" for your browser or file manager.',
  },
  {
    num: '3',
    title: 'Sign In & Check Attendance on the Go',
    body: 'Launch Here!, sign in with Google, create or join your group, and start checking students in on the go at your next event — no pre-built roster required.',
  },
];
---

<BaseLayout title="Here! — Face-First Student Organization Attendance System (Android APK)">
  <!-- Hero Section -->
  <section id="download" class="scroll-mt-20 pt-8 pb-12 sm:pt-14 sm:pb-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Left Column: Brand & CTA -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex flex-wrap items-center gap-2">
          <span
            id="release-badge-version"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-here-tint text-here-primary border border-here-primary/20"
          >
            <span class="w-2 h-2 rounded-full bg-here-primary"></span>
            <span>{release.version} &middot; Build {release.buildNumber}</span>
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold here-pill-success">
            Face-First &middot; Check In on the Go
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold here-pill-warning">
            {release.minAndroid}
          </span>
        </div>

        <div class="space-y-4">
          <!-- Clean Brand Mark Logo (Cropped, High-Resolution, No Blurry Baked-In Text) -->
          <div class="flex items-center pt-1">
            <img
              src="/assets/brand-mark.png"
              alt="Here! Beta — Student Attendance System"
              width="540"
              height="130"
              fetchpriority="high"
              class="w-56 sm:w-64 md:w-72 h-auto object-contain drop-shadow-xs"
            />
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-[34px] font-extrabold text-here-text tracking-tight leading-tight text-balance">
            A simple, face-first attendance system made for students.
          </h1>
          <p class="text-base sm:text-lg font-bold text-here-primary leading-snug text-pretty">
            No pre-built roster needed. Attendance checkers can scan faces, register walk-ins, and check students in on the go.
          </p>
          <p class="text-sm sm:text-base text-here-muted leading-relaxed max-w-2xl text-pretty">
            Built for student organizations, university clubs, and academic events. Whether it’s a quick single-session meeting or a multi-day event, Here! combines on-device facial recognition with offline check-in caching and instant CSV exports — so you can take attendance anywhere, even without Wi-Fi.
          </p>
        </div>

        <!-- Primary & Secondary CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
          <a
            id="apk-download-btn"
            href={release.downloadUrl}
            data-fallback-url={FALLBACK_RELEASE.downloadUrl}
            class="here-btn-primary text-base px-6 py-3.5 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-here-primary"
          >
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download for Android (.apk)</span>
          </a>

          <a
            href="/changelog"
            class="here-btn-outline text-base px-6 py-3.5 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-here-primary"
          >
            <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>View Changelog</span>
          </a>
        </div>

        <!-- Release Metadata Bar -->
        <div class="here-card p-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-left tabular-nums">
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-here-muted">Release Version</div>
            <div id="release-meta-version" class="mt-0.5 text-sm font-extrabold text-here-text">
              {release.version} (Build {release.buildNumber})
            </div>
          </div>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-here-muted">APK Size</div>
            <div id="release-meta-size" class="mt-0.5 text-sm font-extrabold text-here-text">
              {release.sizeFormatted}
            </div>
          </div>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-here-muted">Released</div>
            <div id="release-meta-date" class="mt-0.5 text-sm font-extrabold text-here-text">
              {release.publishedDateFormatted}
            </div>
          </div>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-here-muted">Package ID</div>
            <div class="mt-0.5 text-xs sm:text-sm font-mono font-bold text-here-primary break-all sm:truncate" title={release.packageName}>
              {release.packageName}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Tactile App Interface Preview Card (Multi-Group Home Hub) -->
      <div class="lg:col-span-5">
        <div class="here-card overflow-hidden border border-here-border shadow-sm">
          <!-- Simulated TealBand Home Header (matching group_page.dart) -->
          <div class="bg-here-primary text-here-onPrimary p-4 sm:p-5 rounded-b-[22px]">
            <div class="flex items-center justify-between gap-2">
              <div class="inline-flex items-center gap-1.5 font-extrabold text-lg tracking-tight">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 5L5 19M5 19h10M5 19V9" />
                </svg>
                <span>Here!</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center relative" title="Notifications">
                  <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                  </svg>
                  <span class="absolute -top-0.5 -right-0.5 w-3.5 h-3.5 bg-rose-500 text-[9px] font-bold text-white rounded-full flex items-center justify-center">2</span>
                </div>
                <div class="w-7 h-7 rounded-full bg-white/20 border border-white/40 flex items-center justify-center font-extrabold text-xs text-white">
                  WD
                </div>
              </div>
            </div>

            <div class="mt-3 flex items-baseline justify-between">
              <div>
                <div class="text-base sm:text-lg font-extrabold tracking-tight">West Dasig</div>
                <div class="text-xs text-here-onPrimary/80">west.dasig@university.edu</div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-here-successBg text-here-successFg shrink-0">
                Synced
              </span>
            </div>

            <!-- Active / Archived Tab Selector -->
            <div class="mt-3.5 p-1 bg-white/15 rounded-xl flex items-center gap-1 text-xs">
              <div class="flex-1 py-1 px-3 rounded-lg font-extrabold bg-here-surface text-here-primary shadow-xs text-center tabular-nums">
                Active (3)
              </div>
              <div class="flex-1 py-1 px-3 rounded-lg font-semibold text-white/80 text-center tabular-nums">
                Archived (0)
              </div>
            </div>
          </div>

          <!-- Multi-Group List (matching group_page.dart cards) -->
          <div class="p-4 space-y-2.5 bg-here-bg/60">
            <div class="text-[11px] font-bold uppercase tracking-wider text-here-muted px-1 flex items-center justify-between">
              <span>My Organizations</span>
              <span class="text-[10px] text-here-primary font-bold">3 Workspaces</span>
            </div>

            <!-- Group 1: CS Student Society -->
            <div class="here-card p-3 flex items-center justify-between gap-3 hover:border-here-primary/40 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-[12px] bg-here-tint text-here-primary font-extrabold text-sm flex items-center justify-center shrink-0">
                  CS
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-here-text truncate">CS Student Society</div>
                  <div class="text-xs text-here-muted truncate">Owner &middot; 16 Attendees &middot; 2 Active Events</div>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold here-pill-tint shrink-0">
                Owner
              </span>
            </div>

            <!-- Group 2: Google Developer Student Club -->
            <div class="here-card p-3 flex items-center justify-between gap-3 hover:border-here-primary/40 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-[12px] bg-emerald-500/10 text-emerald-700 font-extrabold text-sm flex items-center justify-center shrink-0">
                  GD
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-here-text truncate">Google Developer Student Club</div>
                  <div class="text-xs text-here-muted truncate">Admin &middot; 42 Attendees &middot; Flutter Study Jam</div>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                Admin
              </span>
            </div>

            <!-- Group 3: Data Science Society -->
            <div class="here-card p-3 flex items-center justify-between gap-3 hover:border-here-primary/40 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-[12px] bg-indigo-500/10 text-indigo-700 font-extrabold text-sm flex items-center justify-center shrink-0">
                  DS
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-bold text-here-text truncate">Data Science Society</div>
                  <div class="text-xs text-here-muted truncate">Member &middot; 28 Attendees &middot; Kaggle Meetups</div>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 shrink-0">
                Member
              </span>
            </div>

            <!-- Bottom Actions: Create & Join -->
            <div class="pt-1 flex items-center justify-between text-xs text-here-muted px-1">
              <span class="inline-flex items-center gap-1 font-semibold text-here-primary">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                <span>New group</span>
              </span>
              <a
                id="release-notes-link"
                href="/changelog"
                class="font-bold text-here-primary hover:underline flex items-center gap-1 focus-visible:ring-2 focus-visible:ring-here-primary rounded"
              >
                <span>Release notes</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive App Showcase & Android Screenshots Section -->
  <AppShowcase />

  <!-- Feature Highlights Grid -->
  <section id="features" class="scroll-mt-20 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-here-border">
    <div class="max-w-2xl">
      <div class="text-xs font-bold uppercase tracking-wider text-here-primary">
        Face-First &amp; Built for Real Campus Conditions
      </div>
      <h2 class="mt-1 text-2xl sm:text-3xl font-extrabold text-here-text tracking-tight text-balance">
        Skip the spreadsheet prep — check students in on the go
      </h2>
      <p class="mt-2 text-sm sm:text-base text-here-muted">
        Whether 20 or 500 students show up, attendance checkers don’t need to collect photos or CSV rosters ahead of time. Scan faces on the go, register walk-in attendees on the spot, and recognize them automatically at every future event.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-5">
      {features.map((feature) => (
        <article class="here-card p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class:list={['px-2.5 py-1 rounded-full text-xs font-bold', feature.badgeStyle]}>
                {feature.badge}
              </span>
            </div>
            <h3 class="text-lg font-extrabold text-here-text tracking-tight">
              {feature.title}
            </h3>
            <p class="mt-2 text-sm text-here-muted leading-relaxed">
              {feature.description}
            </p>
          </div>

          <ul class="mt-5 pt-4 border-t border-here-border space-y-2">
            {feature.highlights.map((item) => (
              <li class="flex items-start gap-2 text-xs sm:text-sm font-semibold text-here-text">
                <svg class="w-4 h-4 text-here-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Quick Start / How It Works Section -->
  <section id="how-it-works" class="scroll-mt-20 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-here-border">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="max-w-2xl">
        <div class="text-xs font-bold uppercase tracking-wider text-here-primary">
          Zero-Prep Workflow
        </div>
        <h2 class="mt-1 text-2xl sm:text-3xl font-extrabold text-here-text tracking-tight text-balance">
          How It Works in 4 Simple Steps
        </h2>
        <p class="mt-2 text-sm sm:text-base text-here-muted">
          Mirrors the in-app Quick Start Guide — go from creating a group to checking students’ attendance on the go in under a minute.
        </p>
      </div>
      <span class="inline-flex items-center px-3 py-1.5 rounded-here bg-here-tint text-here-primary text-xs font-bold self-start md:self-auto">
        No pre-enrollment required
      </span>
    </div>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {quickStartSteps.map((item) => (
        <div class="here-card p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="w-9 h-9 rounded-[10px] bg-here-tint text-here-primary font-extrabold text-sm flex items-center justify-center">
                {item.step}
              </span>
              <span class="text-[11px] font-bold text-here-muted uppercase tracking-wider">
                {item.subtitle}
              </span>
            </div>
            <h3 class="text-base font-extrabold text-here-text">
              {item.title}
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-here-muted leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3-Step Android APK Installation Guide -->
  <section id="install" class="scroll-mt-20 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto border-t border-here-border">
    <div class="here-card p-6 sm:p-8">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-here-border">
        <div>
          <div class="inline-flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold here-pill-tint">
              Android Sideloading Guide
            </span>
            <span class="text-xs font-semibold text-here-muted">
              Package: <code class="font-mono text-here-text">com.meowtys.here</code>
            </span>
          </div>
          <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold text-here-text tracking-tight text-balance">
            Install Here! on Your Android Device
          </h2>
          <p class="mt-1 text-sm text-here-muted">
            Follow these 3 quick steps to install the beta APK on Android 7.0 (Nougat) or newer.
          </p>
        </div>

        <a
          id="apk-download-btn-bottom"
          href={release.downloadUrl}
          class="here-btn-primary shrink-0 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-here-primary"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download {release.version} (.apk)</span>
        </a>
      </div>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-5">
        {installSteps.map((step) => (
          <div class="p-4 rounded-here bg-here-bg border border-here-border">
            <div class="flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-here-primary text-here-onPrimary font-extrabold text-xs flex items-center justify-center">
                {step.num}
              </span>
              <h3 class="text-sm sm:text-base font-extrabold text-here-text">
                {step.title}
              </h3>
            </div>
            <p class="mt-2.5 text-xs sm:text-sm text-here-muted leading-relaxed">
              {step.body}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-6 pt-5 border-t border-here-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-here-muted">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded-full font-bold here-pill-success">Privacy First</span>
          <span>Facial feature vectors are computed on-device with explicit consent and never shared with third parties.</span>
        </div>
        <div class="flex items-center gap-4 font-bold text-here-primary">
          <a href="/privacy" class="hover:underline">Read Privacy Policy &rarr;</a>
          <a href="/terms" class="hover:underline">Terms of Use &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightweight Client-Side Release Hydrator (queries /releases and picks first .apk asset, with static v2.1.1-beta fallback) -->
  <script is:inline define:vars={{ RELEASES_API_URL, FALLBACK_RELEASE }}>
    (async function hydrateLatestApkRelease() {
      try {
        const res = await fetch(RELEASES_API_URL, {
          headers: { Accept: 'application/vnd.github+json' },
        });
        if (!res.ok) return;
        const releases = await res.json();
        if (!Array.isArray(releases)) return;

        let matchedRelease = null;
        let matchedApk = null;
        for (const rel of releases) {
          if (!rel || rel.draft === true || !Array.isArray(rel.assets)) continue;
          const apk = rel.assets.find(
            (a) =>
              a &&
              typeof a.name === 'string' &&
              a.name.toLowerCase().endsWith('.apk') &&
              typeof a.browser_download_url === 'string'
          );
          if (apk) {
            matchedRelease = rel;
            matchedApk = apk;
            break;
          }
        }

        if (!matchedRelease || !matchedApk) return;

        const version = matchedRelease.tag_name || FALLBACK_RELEASE.version;
        const buildMatch = typeof matchedRelease.name === 'string' ? /\(Build\s+(\d+)\)/i.exec(matchedRelease.name) : null;
        const buildNum = buildMatch ? Number.parseInt(buildMatch[1], 10) : FALLBACK_RELEASE.buildNumber;
        const downloadUrl = matchedApk.browser_download_url || FALLBACK_RELEASE.downloadUrl;
        const sizeMB =
          typeof matchedApk.size === 'number' && matchedApk.size > 0
            ? (matchedApk.size / (1024 * 1024)).toFixed(1) + ' MB'
            : FALLBACK_RELEASE.sizeFormatted;
        const dateStr = matchedRelease.published_at
          ? new Date(matchedRelease.published_at).toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            })
          : FALLBACK_RELEASE.publishedDateFormatted;

        const btnPrimary = document.getElementById('apk-download-btn');
        const btnBottom = document.getElementById('apk-download-btn-bottom');
        const badgeVer = document.getElementById('release-badge-version');
        const metaVer = document.getElementById('release-meta-version');
        const metaSize = document.getElementById('release-meta-size');
        const metaDate = document.getElementById('release-meta-date');

        if (btnPrimary) btnPrimary.setAttribute('href', downloadUrl);
        if (btnBottom) {
          btnBottom.setAttribute('href', downloadUrl);
          const span = btnBottom.querySelector('span');
          if (span) span.textContent = 'Download ' + version + ' (.apk)';
        }
        if (badgeVer) {
          const textSpan = badgeVer.querySelector('span:last-child');
          if (textSpan) textSpan.textContent = version + ' · Build ' + buildNum;
        }
        if (metaVer) metaVer.textContent = version + ' (Build ' + buildNum + ')';
        const footerVer = document.getElementById('footer-release-version');
        if (footerVer) footerVer.textContent = version;
        if (metaSize) metaSize.textContent = sizeMB;
        if (metaDate) metaDate.textContent = dateStr;
      } catch (_err) {
        // Static fallback (v2.1.1-beta) remains in place
      }
    })();
  </script>
</BaseLayout>
